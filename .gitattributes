# Preserve evidence bytes: Python csv writes RFC4180 CRLF; hashes cover exact bytes.
*.csv -text whitespace=cr-at-eol
*.log -text -whitespace
# Preserve third-party license/NOTICE evidence byte-for-byte; source headings and
# whitespace may resemble conflict markers, so omit these blobs from textual diffs.
evidence/wp7/sbom/texts/*.txt binary
evidence/wp7/sbom/*.json -text -diff
# Keep binary evidence out of textual diffs.
*.png binary
*.zip binary
*.pbf binary
