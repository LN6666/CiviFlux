# Selected Qwen-based Jev: Featherless SimpleJev typed /v1/classifier.
# Free demo requires no key. Remote requests remain OFF until explicitly authorized.
# No local model deployment, downloads or cloud-server setup is performed.
SIMPLEJEV_BASE_URL=https://simple-jev-demo-api.featherless.ai
SIMPLEJEV_MODEL=featherless-ai/Qwen3.8-27B-classifier
SIMPLEJEV_ONTOLOGY_VERSION=1.0.0
SIMPLEJEV_ALLOW_EGRESS=0
SIMPLEJEV_MAX_CALLS=0
SIMPLEJEV_BUDGET_ID=unapproved
SIMPLEJEV_MAX_QUESTIONS=6
SIMPLEJEV_MAX_WALL_MS=45000
# Production origin is https://api.featherless.ai; paid access remains disabled.
# A separate explicit authorization is required before switching endpoint/budget.
FEATHERLESS_API_KEY=

# Optional ordinary chat-scoring comparison only. This does NOT satisfy SimpleJev.
DASHSCOPE_API_KEY=
QWEN_API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_API_MODEL=qwen3.7-plus-2026-05-26
QWEN_API_RESPONSE_FORMAT=json_schema
QWEN_API_MAX_OUTPUT_TOKENS=512
QWEN_API_ALLOW_EGRESS=0
QWEN_API_MAX_CALLS=0
QWEN_API_BUDGET_ID=unapproved
