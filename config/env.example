# Canonical configuration template: ../.env.example
# The current provider is hosted Featherless SimpleJev, not a local Reflex server.
# Keep all remote classifier calls off until a bounded authorization is supplied.
SIMPLEJEV_BASE_URL=https://simple-jev-demo-api.featherless.ai
SIMPLEJEV_MODEL=featherless-ai/Qwen3.8-27B-classifier
SIMPLEJEV_ALLOW_EGRESS=0
SIMPLEJEV_MAX_CALLS=0
SIMPLEJEV_BUDGET_ID=unapproved
FEATHERLESS_API_KEY=
URBANIMPACT_BIND_HOST=127.0.0.1
