{
  "$defs": {
    "LinkType": {
      "enum": [
        "ROAD_CONNECTS_TO",
        "ROUTE_USES_SEGMENT",
        "SEGMENT_USED_BY_ROUTE",
        "STOP_ON_ROUTE",
        "FACILITY_ACCESSED_VIA",
        "SEGMENT_ACCESS_TO_FACILITY",
        "DISTRICT_CONTAINS",
        "CELL_LOCATED_IN",
        "INCIDENT_OCCURS_AT",
        "INCIDENT_RESTRICTS",
        "SCENARIO_CONTAINS_RESTRICTION",
        "RUN_EVALUATES_SCENARIO",
        "OBSERVATION_ABOUT_OBJECT",
        "DERIVED_FROM",
        "SUPPORTED_BY_EVIDENCE"
      ],
      "title": "LinkType",
      "type": "string"
    },
    "Temporal": {
      "additionalProperties": false,
      "properties": {
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        }
      },
      "title": "Temporal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
      "title": "Id",
      "type": "string"
    },
    "src": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
      "title": "Src",
      "type": "string"
    },
    "dst": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
      "title": "Dst",
      "type": "string"
    },
    "relation_type": {
      "$ref": "#/$defs/LinkType"
    },
    "evidence_refs": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "asserted_or_derived": {
      "enum": [
        "asserted",
        "derived"
      ],
      "title": "Asserted Or Derived",
      "type": "string"
    },
    "derivation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Derivation Id"
    },
    "valid_time": {
      "$ref": "#/$defs/Temporal",
      "default": {
        "valid_from": null,
        "valid_to": null
      }
    },
    "confidence_status": {
      "enum": [
        "verified",
        "candidate",
        "assumed",
        "unknown"
      ],
      "title": "Confidence Status",
      "type": "string"
    },
    "base_strength": {
      "default": 1,
      "minimum": 0,
      "title": "Base Strength",
      "type": "number"
    }
  },
  "required": [
    "id",
    "src",
    "dst",
    "relation_type",
    "evidence_refs",
    "asserted_or_derived",
    "confidence_status"
  ],
  "title": "Link",
  "type": "object"
}
