{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "affects": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Affects",
          "type": "array"
        }
      },
      "required": [
        "id",
        "description",
        "affects"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "Incident": {
      "additionalProperties": false,
      "properties": {
        "source_refs": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "location_text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Location Text",
          "type": "string"
        },
        "geometry_ref": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Geometry Ref",
          "type": "string"
        },
        "geometry_status": {
          "enum": [
            "verified",
            "assumed",
            "uncertain"
          ],
          "title": "Geometry Status",
          "type": "string"
        },
        "notification_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notification Time"
        },
        "point": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Point"
        },
        "perimeter_source": {
          "anyOf": [
            {
              "enum": [
                "user",
                "imported"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Perimeter Source"
        },
        "perimeter": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Perimeter"
        }
      },
      "required": [
        "source_refs",
        "location_text",
        "geometry_ref",
        "geometry_status"
      ],
      "title": "Incident",
      "type": "object"
    },
    "Restriction": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
          "title": "Id",
          "type": "string"
        },
        "edge_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Edge Ids",
          "type": "array"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "valid_to": {
          "format": "date-time",
          "title": "Valid To",
          "type": "string"
        },
        "blocked_classes": {
          "items": {
            "enum": [
              "passenger",
              "bus",
              "emergency",
              "delivery",
              "truck",
              "bicycle",
              "pedestrian",
              "taxi",
              "motorcycle"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Blocked Classes",
          "type": "array"
        },
        "evidence_kind": {
          "enum": [
            "observed",
            "announced",
            "assumed"
          ],
          "title": "Evidence Kind",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "restriction_type": {
          "const": "closure",
          "default": "closure",
          "title": "Restriction Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "edge_ids",
        "valid_from",
        "valid_to",
        "blocked_classes",
        "evidence_kind",
        "evidence_refs"
      ],
      "title": "Restriction",
      "type": "object"
    },
    "SeedSpec": {
      "additionalProperties": false,
      "properties": {
        "entity_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Entity Ids",
          "type": "array"
        },
        "same_for_pair": {
          "const": true,
          "default": true,
          "title": "Same For Pair",
          "type": "boolean"
        }
      },
      "required": [
        "entity_ids"
      ],
      "title": "SeedSpec",
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Window",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
      "title": "Scenario Id",
      "type": "string"
    },
    "citypack_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
      "title": "Citypack Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "road",
        "fire"
      ],
      "title": "Kind",
      "type": "string"
    },
    "timezone": {
      "default": "Europe/Helsinki",
      "title": "Timezone",
      "type": "string"
    },
    "analysis_at": {
      "format": "date-time",
      "title": "Analysis At",
      "type": "string"
    },
    "window": {
      "$ref": "#/$defs/Window"
    },
    "restrictions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Restriction"
      },
      "title": "Restrictions",
      "type": "array"
    },
    "incident": {
      "anyOf": [
        {
          "$ref": "#/$defs/Incident"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "assumptions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "objective": {
      "default": "facility_access",
      "enum": [
        "facility_access",
        "transit_association",
        "road_disruption"
      ],
      "title": "Objective",
      "type": "string"
    },
    "engine": {
      "default": "routing",
      "enum": [
        "routing",
        "routing_sumo"
      ],
      "title": "Engine",
      "type": "string"
    },
    "ranking": {
      "default": "A2",
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "A4",
        "A5"
      ],
      "title": "Ranking",
      "type": "string"
    },
    "seed_spec": {
      "$ref": "#/$defs/SeedSpec"
    }
  },
  "required": [
    "scenario_id",
    "citypack_id",
    "kind",
    "analysis_at",
    "window",
    "seed_spec"
  ],
  "title": "Scenario",
  "type": "object"
}
