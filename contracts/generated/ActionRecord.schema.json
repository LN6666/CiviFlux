{
  "$defs": {
    "ActionType": {
      "enum": [
        "CreateScenario",
        "AddRoadRestriction",
        "CreateFireIncident",
        "AttachImportedPerimeter",
        "AttachEvidence",
        "ValidateScenario",
        "RunScenario",
        "CancelRun",
        "CompareRuns",
        "ChangeAnalysisPolicy",
        "ExportResultBundle"
      ],
      "title": "ActionType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ontology_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Ontology Version",
      "type": "string"
    },
    "action_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
      "title": "Action Id",
      "type": "string"
    },
    "action_type": {
      "$ref": "#/$defs/ActionType"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "parameters_hash": {
      "title": "Parameters Hash",
      "type": "string"
    },
    "actor_context": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Actor Context"
    },
    "input_object_refs": {
      "items": {
        "type": "string"
      },
      "title": "Input Object Refs",
      "type": "array"
    },
    "precondition_results": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Precondition Results",
      "type": "array"
    },
    "output_object_refs": {
      "items": {
        "type": "string"
      },
      "title": "Output Object Refs",
      "type": "array"
    },
    "status": {
      "enum": [
        "validated",
        "committed",
        "rejected",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "provenance_hash": {
      "title": "Provenance Hash",
      "type": "string"
    }
  },
  "required": [
    "action_id",
    "action_type",
    "timestamp",
    "parameters_hash",
    "actor_context",
    "input_object_refs",
    "precondition_results",
    "output_object_refs",
    "status",
    "provenance_hash"
  ],
  "title": "ActionRecord",
  "type": "object"
}
