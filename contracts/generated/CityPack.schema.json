{
  "$defs": {
    "Connection": {
      "additionalProperties": false,
      "properties": {
        "from_edge": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
          "title": "From Edge",
          "type": "string"
        },
        "to_edge": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
          "title": "To Edge",
          "type": "string"
        },
        "allowed_vehicle_classes": {
          "items": {
            "enum": [
              "passenger",
              "bus",
              "emergency",
              "delivery",
              "truck",
              "bicycle",
              "pedestrian",
              "taxi",
              "motorcycle"
            ],
            "type": "string"
          },
          "title": "Allowed Vehicle Classes",
          "type": "array"
        }
      },
      "required": [
        "from_edge",
        "to_edge",
        "allowed_vehicle_classes"
      ],
      "title": "Connection",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
          "title": "Id",
          "type": "string"
        },
        "source": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
          "title": "Target",
          "type": "string"
        },
        "length_m": {
          "exclusiveMinimum": 0,
          "title": "Length M",
          "type": "number"
        },
        "speed_kph": {
          "exclusiveMinimum": 0,
          "title": "Speed Kph",
          "type": "number"
        },
        "allowed_vehicle_classes": {
          "items": {
            "enum": [
              "passenger",
              "bus",
              "emergency",
              "delivery",
              "truck",
              "bicycle",
              "pedestrian",
              "taxi",
              "motorcycle"
            ],
            "type": "string"
          },
          "title": "Allowed Vehicle Classes",
          "type": "array"
        },
        "geometry": {
          "default": [],
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Geometry",
          "type": "array"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "external_id": {
          "title": "External Id",
          "type": "string"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "oneway": {
          "default": true,
          "title": "Oneway",
          "type": "boolean"
        },
        "access_evidence": {
          "default": "imported",
          "title": "Access Evidence",
          "type": "string"
        },
        "cost_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost S"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "length_m",
        "speed_kph",
        "allowed_vehicle_classes",
        "source_id",
        "external_id"
      ],
      "title": "Edge",
      "type": "object"
    },
    "Facility": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "Facility",
            "Hospital",
            "FireStation"
          ],
          "title": "Type",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "lon": {
          "title": "Lon",
          "type": "number"
        },
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "entrance_node_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Entrance Node Id"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "external_id": {
          "title": "External Id",
          "type": "string"
        },
        "snap_distance_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snap Distance M"
        },
        "access_status": {
          "default": "candidate",
          "enum": [
            "verified",
            "candidate",
            "unknown"
          ],
          "title": "Access Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "name",
        "lon",
        "lat",
        "entrance_node_id",
        "source_id",
        "external_id"
      ],
      "title": "Facility",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
          "title": "Id",
          "type": "string"
        },
        "lon": {
          "title": "Lon",
          "type": "number"
        },
        "lat": {
          "title": "Lat",
          "type": "number"
        }
      },
      "required": [
        "id",
        "lon",
        "lat"
      ],
      "title": "Node",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
          "title": "Id",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "retrieved_at": {
          "title": "Retrieved At",
          "type": "string"
        },
        "license": {
          "title": "License",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "id",
        "url",
        "sha256",
        "retrieved_at",
        "license"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "citypack_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
      "title": "Citypack Id",
      "type": "string"
    },
    "timezone": {
      "default": "Europe/Helsinki",
      "title": "Timezone",
      "type": "string"
    },
    "network_temporality": {
      "enum": [
        "synthetic",
        "current_snapshot",
        "historical"
      ],
      "title": "Network Temporality",
      "type": "string"
    },
    "transit_temporality": {
      "enum": [
        "synthetic",
        "current_schedule",
        "historical",
        "unavailable"
      ],
      "title": "Transit Temporality",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "array"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "title": "Edges",
      "type": "array"
    },
    "connections": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Connection"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Connections"
    },
    "facilities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Facility"
      },
      "title": "Facilities",
      "type": "array"
    },
    "transit": {
      "additionalProperties": true,
      "title": "Transit",
      "type": "object"
    },
    "evidence": {
      "additionalProperties": true,
      "title": "Evidence",
      "type": "object"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "citypack_id",
    "network_temporality",
    "transit_temporality",
    "sources",
    "nodes",
    "edges"
  ],
  "title": "CityPack",
  "type": "object"
}
