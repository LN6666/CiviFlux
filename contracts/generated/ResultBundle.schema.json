{
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "affects": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Affects",
          "type": "array"
        }
      },
      "required": [
        "id",
        "description",
        "affects"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
          "title": "Id",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "retrieved_at": {
          "title": "Retrieved At",
          "type": "string"
        },
        "license": {
          "title": "License",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "id",
        "url",
        "sha256",
        "retrieved_at",
        "license"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
      "title": "Run Id",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
      "title": "Scenario Id",
      "type": "string"
    },
    "citypack_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
      "title": "Citypack Id",
      "type": "string"
    },
    "ontology_version": {
      "title": "Ontology Version",
      "type": "string"
    },
    "scenario_overlay_hash": {
      "title": "Scenario Overlay Hash",
      "type": "string"
    },
    "action_log_hash": {
      "title": "Action Log Hash",
      "type": "string"
    },
    "projection_id": {
      "title": "Projection Id",
      "type": "string"
    },
    "projection_hash": {
      "title": "Projection Hash",
      "type": "string"
    },
    "source_snapshot_hash": {
      "title": "Source Snapshot Hash",
      "type": "string"
    },
    "demand_kind": {
      "enum": [
        "synthetic",
        "estimated",
        "measured"
      ],
      "title": "Demand Kind",
      "type": "string"
    },
    "network_temporality": {
      "title": "Network Temporality",
      "type": "string"
    },
    "transit_temporality": {
      "title": "Transit Temporality",
      "type": "string"
    },
    "simulation_status": {
      "title": "Simulation Status",
      "type": "string"
    },
    "provider_mode": {
      "enum": [
        "qwen_api",
        "local_qwen",
        "replay",
        "rules",
        "mock_test"
      ],
      "title": "Provider Mode",
      "type": "string"
    },
    "facts": {
      "additionalProperties": true,
      "title": "Facts",
      "type": "object"
    },
    "attention": {
      "additionalProperties": true,
      "title": "Attention",
      "type": "object"
    },
    "graph": {
      "additionalProperties": true,
      "title": "Graph",
      "type": "object"
    },
    "assumptions": {
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "policy": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy"
    }
  },
  "required": [
    "run_id",
    "scenario_id",
    "citypack_id",
    "ontology_version",
    "scenario_overlay_hash",
    "action_log_hash",
    "projection_id",
    "projection_hash",
    "source_snapshot_hash",
    "demand_kind",
    "network_temporality",
    "transit_temporality",
    "simulation_status",
    "provider_mode",
    "facts",
    "attention",
    "graph",
    "assumptions",
    "sources",
    "limitations"
  ],
  "title": "ResultBundle",
  "type": "object"
}
