{
  "$defs": {
    "LinkType": {
      "enum": [
        "ROAD_CONNECTS_TO",
        "ROUTE_USES_SEGMENT",
        "SEGMENT_USED_BY_ROUTE",
        "STOP_ON_ROUTE",
        "FACILITY_ACCESSED_VIA",
        "SEGMENT_ACCESS_TO_FACILITY",
        "DISTRICT_CONTAINS",
        "CELL_LOCATED_IN",
        "INCIDENT_OCCURS_AT",
        "INCIDENT_RESTRICTS",
        "SCENARIO_CONTAINS_RESTRICTION",
        "RUN_EVALUATES_SCENARIO",
        "OBSERVATION_ABOUT_OBJECT",
        "DERIVED_FROM",
        "SUPPORTED_BY_EVIDENCE"
      ],
      "title": "LinkType",
      "type": "string"
    },
    "ObjectType": {
      "enum": [
        "RoadSegment",
        "Junction",
        "TransitRoute",
        "TransitStop",
        "Facility",
        "Hospital",
        "FireStation",
        "District",
        "PopulationCell",
        "FireIncident",
        "RoadRestriction",
        "Scenario",
        "SimulationRun",
        "ImpactObservation",
        "EvidenceSource",
        "AnalysisPolicy"
      ],
      "title": "ObjectType",
      "type": "string"
    },
    "Window": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Window",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "projection_id": {
      "title": "Projection Id",
      "type": "string"
    },
    "ontology_version": {
      "default": "1.0.0",
      "title": "Ontology Version",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
      "title": "Scenario Id",
      "type": "string"
    },
    "analysis_time": {
      "format": "date-time",
      "title": "Analysis Time",
      "type": "string"
    },
    "time_window": {
      "$ref": "#/$defs/Window"
    },
    "spatial_scope": {
      "const": "source_citypack_extent",
      "default": "source_citypack_extent",
      "title": "Spatial Scope",
      "type": "string"
    },
    "max_hops": {
      "default": null,
      "title": "Max Hops",
      "type": "null"
    },
    "objective": {
      "title": "Objective",
      "type": "string"
    },
    "projection_kind": {
      "default": "operational",
      "enum": [
        "operational",
        "dependency_evidence"
      ],
      "title": "Projection Kind",
      "type": "string"
    },
    "allowed_object_types": {
      "items": {
        "$ref": "#/$defs/ObjectType"
      },
      "title": "Allowed Object Types",
      "type": "array"
    },
    "allowed_link_types": {
      "items": {
        "$ref": "#/$defs/LinkType"
      },
      "title": "Allowed Link Types",
      "type": "array"
    },
    "relation_policy_hash": {
      "title": "Relation Policy Hash",
      "type": "string"
    },
    "source_snapshot_hash": {
      "title": "Source Snapshot Hash",
      "type": "string"
    }
  },
  "required": [
    "projection_id",
    "scenario_id",
    "analysis_time",
    "time_window",
    "objective",
    "allowed_object_types",
    "allowed_link_types",
    "relation_policy_hash",
    "source_snapshot_hash"
  ],
  "title": "ProjectionSpec",
  "type": "object"
}
