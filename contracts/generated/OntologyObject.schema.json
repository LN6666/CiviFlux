{
  "$defs": {
    "ObjectType": {
      "enum": [
        "RoadSegment",
        "Junction",
        "TransitRoute",
        "TransitStop",
        "Facility",
        "Hospital",
        "FireStation",
        "District",
        "PopulationCell",
        "FireIncident",
        "RoadRestriction",
        "Scenario",
        "SimulationRun",
        "ImpactObservation",
        "EvidenceSource",
        "AnalysisPolicy"
      ],
      "title": "ObjectType",
      "type": "string"
    },
    "Temporal": {
      "additionalProperties": false,
      "properties": {
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        }
      },
      "title": "Temporal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "object_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
      "title": "Object Id",
      "type": "string"
    },
    "object_type": {
      "$ref": "#/$defs/ObjectType"
    },
    "source_namespace": {
      "title": "Source Namespace",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "valid_time": {
      "$ref": "#/$defs/Temporal",
      "default": {
        "valid_from": null,
        "valid_to": null
      }
    },
    "provenance_refs": {
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_:.@+\\-/]+$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Provenance Refs",
      "type": "array"
    },
    "evidence_level": {
      "enum": [
        "authoritative/imported",
        "user_assumed",
        "derived",
        "simulated",
        "model_scored"
      ],
      "title": "Evidence Level",
      "type": "string"
    },
    "properties": {
      "type": "object",
      "additionalProperties": true,
      "title": "Properties"
    },
    "geometry_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Geometry Ref"
    }
  },
  "required": [
    "object_id",
    "object_type",
    "source_namespace",
    "source_id",
    "provenance_refs",
    "evidence_level"
  ],
  "title": "OntologyObject",
  "type": "object"
}
