{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civiflux.local/schemas/action-record-v1.json",
  "title": "CiviFlux Action Record",
  "type": "object",
  "required": ["action_id", "action_type", "timestamp", "parameters_hash", "precondition_results", "status", "provenance_hash"],
  "properties": {
    "action_id": {"type": "string", "minLength": 1},
    "action_type": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "actor_context": {"type": ["string", "null"]},
    "parameters_hash": {"type": "string", "minLength": 8},
    "input_object_refs": {"type": "array", "items": {"type": "string"}},
    "precondition_results": {"type": "array", "items": {"type": "object"}},
    "output_object_refs": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["validated", "committed", "rejected", "failed", "cancelled"]},
    "error": {"type": ["object", "null"]},
    "provenance_hash": {"type": "string", "minLength": 8}
  },
  "additionalProperties": false
}
