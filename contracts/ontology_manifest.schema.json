{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civiflux.local/schemas/ontology-manifest-v1.json",
  "title": "CiviFlux Operational Ontology Manifest",
  "type": "object",
  "required": ["ontology_version", "object_types", "link_types", "interfaces", "action_types", "functions", "projections"],
  "properties": {
    "ontology_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "object_types": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}, "interfaces": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true}},
    "link_types": {"type": "array", "items": {"type": "object", "required": ["name", "src", "dst"], "properties": {"name": {"type": "string"}, "src": {"type": "string"}, "dst": {"type": "string"}, "reverse_name": {"type": ["string", "null"]}}, "additionalProperties": true}},
    "interfaces": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}}, "additionalProperties": true}},
    "action_types": {"type": "array", "items": {"type": "object", "required": ["name", "parameters", "preconditions"], "properties": {"name": {"type": "string"}, "parameters": {"type": "array"}, "preconditions": {"type": "array"}}, "additionalProperties": true}},
    "functions": {"type": "array", "items": {"type": "object", "required": ["name", "class"], "properties": {"name": {"type": "string"}, "class": {"enum": ["deterministic", "simulation", "graph", "system_one", "llm_optional"]}}, "additionalProperties": true}},
    "projections": {"type": "array", "items": {"type": "object", "required": ["name", "allowed_object_types", "allowed_link_types"], "properties": {"name": {"type": "string"}, "allowed_object_types": {"type": "array", "items": {"type": "string"}}, "allowed_link_types": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true}}
  },
  "additionalProperties": false
}
