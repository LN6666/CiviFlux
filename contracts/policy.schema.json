{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "provider_mode": {
      "enum": [
        "simplejev_demo",
        "simplejev_api",
        "rules",
        "local_qwen",
        "replay",
        "mock_test",
        "qwen_api",
        "remote_reflex"
      ]
    },
    "requested_model": {
      "type": "string",
      "minLength": 1
    },
    "resolved_model": {
      "type": "string",
      "minLength": 1
    },
    "rubric_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scores": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "epsilon": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "confidence_use": {
      "const": "diagnostic_only"
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "wall_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "forward_passes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "device": {
          "type": [
            "string",
            "null"
          ]
        },
        "peak_memory_mb": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "questions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "wall_ms",
        "forward_passes",
        "questions",
        "device",
        "peak_memory_mb"
      ],
      "additionalProperties": false
    },
    "applied_transition_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "backend_impl": {
      "type": "string",
      "minLength": 1
    },
    "backend_revision": {
      "type": "string",
      "minLength": 1
    },
    "model_revision": {
      "type": "string",
      "minLength": 1
    },
    "calibration_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "permutations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "dtype": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "provider_mode",
    "requested_model",
    "resolved_model",
    "rubric_hash",
    "context_hash",
    "scores",
    "epsilon",
    "confidence_use",
    "usage",
    "applied_transition_hash",
    "backend_impl",
    "backend_revision",
    "model_revision",
    "calibration_sha256",
    "permutations",
    "dtype"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
