{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "citypack_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "road",
        "fire"
      ]
    },
    "timezone": {
      "const": "Europe/Helsinki"
    },
    "analysis_at": {
      "type": "string",
      "format": "date-time"
    },
    "window": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "restrictions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "edge_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_to": {
            "type": "string",
            "format": "date-time"
          },
          "blocked_classes": {
            "type": "array",
            "items": {
              "enum": [
                "passenger",
                "bus",
                "emergency",
                "bicycle",
                "pedestrian",
                "all"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "evidence_kind": {
            "enum": [
              "observed",
              "announced",
              "assumed"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "edge_ids",
          "valid_from",
          "valid_to",
          "blocked_classes",
          "evidence_kind",
          "evidence_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "incident": {
      "type": "object",
      "properties": {
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "location_text": {
          "type": "string",
          "minLength": 1
        },
        "geometry_ref": {
          "type": "string",
          "minLength": 1
        },
        "geometry_status": {
          "enum": [
            "verified",
            "assumed",
            "uncertain"
          ]
        },
        "notification_time": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "source_refs",
        "location_text",
        "geometry_ref",
        "geometry_status"
      ],
      "additionalProperties": false
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "affects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "description",
          "affects"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "objective": {
      "enum": [
        "facility_access",
        "transit_association",
        "road_disruption"
      ]
    },
    "engine": {
      "enum": [
        "routing",
        "routing_sumo"
      ]
    },
    "ranking": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "A4",
        "A5"
      ]
    },
    "seed_spec": {
      "type": "object",
      "properties": {
        "entity_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "same_for_pair": {
          "const": true
        }
      },
      "required": [
        "entity_ids",
        "same_for_pair"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "citypack_id",
    "kind",
    "timezone",
    "analysis_at",
    "window",
    "restrictions",
    "assumptions",
    "objective",
    "engine",
    "ranking",
    "seed_spec"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "fire"
          }
        }
      },
      "then": {
        "required": [
          "incident"
        ]
      }
    }
  ]
}
